{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // TS6310：被引用的 composite 项目不能禁用产出。
    // 改为「只产出类型声明」并输出到 node_modules/.tmp（已被 git 忽略），
    // 既让 `tsc -b` 通过，又不会在仓库里留下 vite.config.js / .d.ts 产物。
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
